MAVIBASE_DEPLOYMENT_MODE=development
MAVIBASE_PUBLIC_URL=http://localhost:3000
MAVIBASE_HTTP_HOST=127.0.0.1
MAVIBASE_HTTP_PORT=3000
MAVIBASE_CORS_ORIGINS=http://localhost:3000
MAVIBASE_LOG_LEVEL=debug

MAVIBASE_DATABASE_URL=postgresql://mavibase:mavibase@localhost:5432/mavibase
MAVIBASE_REDIS_URL=redis://localhost:6379

MAVIBASE_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
MAVIBASE_ENCRYPTION_KEY=replace-with-a-random-key-at-least-32-characters
